# The sandcastle trick: cool teals fill the warm slots so most of the buffer
# reads calm, and a single hot red is saved for keywords.
{
  slug = "seaglass";
  name = "Seaglass";
  author = "Daniel Cox";
  palette = {
    base00 = "24292b"; # bg
    base01 = "2c3234"; # lighter bg
    base02 = "3a4144"; # selection
    base03 = "63706f"; # comments
    base04 = "8b9896"; # dark fg
    base05 = "c9d4d0"; # fg
    base06 = "dde6e2"; # light fg
    base07 = "eef4f1"; # lightest fg
    base08 = "7fb3a8"; # teal in the red slot
    base09 = "b8a173"; # muted gold
    base0A = "c2b271"; # sand
    base0B = "6f9fa8"; # blue-teal strings
    base0C = "8fbfae"; # green-teal
    base0D = "8aa9a0"; # desaturated teal functions
    base0E = "e07878"; # the one hot colour, on keywords
    base0F = "b8825c"; # brown
  };
}
